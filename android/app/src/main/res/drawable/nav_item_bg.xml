<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_accent_soft" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ink_line">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle"><solid android:color="#000" /><corners android:radius="26dp" /></shape>
            </item>
        </ripple>
    </item>
</selector>
