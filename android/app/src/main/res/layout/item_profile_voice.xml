<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="8dp"
	android:orientation="horizontal"
	android:gravity="center_vertical"
	android:background="@drawable/plan_card_bg"
	android:foreground="?attr/selectableItemBackground"
	android:clickable="true"
	android:focusable="true"
	android:padding="12dp">

	<TextView
		android:id="@+id/txt_voice_check"
		android:layout_width="22dp"
		android:layout_height="22dp"
		android:layout_marginRight="10dp"
		android:gravity="center"
		android:text="check_circle"
		android:textSize="18sp"
		android:textColor="@color/ink_accent"
		android:fontFamily="@font/material_icons"
		android:visibility="gone" />

	<!-- One icon carries every state: download (not cached) → spinner
	     (downloading) → pause (auto-playing right after download finishes)
	     → play (paused). No separate download button anymore — tapping
	     this IS the only action, matching a normal play button everywhere
	     else in the app once cached. -->
	<FrameLayout
		android:layout_width="40dp"
		android:layout_height="40dp">

		<TextView
			android:id="@+id/btn_voice_play"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:gravity="center"
			android:text="download"
			android:textSize="22sp"
			android:textColor="@color/ink_on_accent"
			android:background="@drawable/circle_bg"
			android:backgroundTint="@color/ink_accent"
			android:fontFamily="@font/material_icons" />

		<ProgressBar
			android:id="@+id/progress_voice_download"
			style="?android:attr/progressBarStyleSmall"
			android:layout_width="22dp"
			android:layout_height="22dp"
			android:layout_gravity="center"
			android:indeterminateTint="#FFFFFF"
			android:visibility="gone" />

	</FrameLayout>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:layout_marginLeft="12dp"
		android:orientation="vertical">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Voice message"
			android:textSize="14sp"
			android:textStyle="bold"
			android:textColor="@color/ink_text" />

		<TextView
			android:id="@+id/txt_voice_duration"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:text="0:00"
			android:textSize="12sp"
			android:textColor="@color/ink_text_2" />

	</LinearLayout>

</LinearLayout>
