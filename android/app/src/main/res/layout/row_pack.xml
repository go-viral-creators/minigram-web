<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="14dp">
    <TextView style="@style/Ink.RowIcon" android:text="public" />
    <LinearLayout style="@style/Ink.RowText">
        <TextView android:id="@+id/pack_name" style="@style/Ink.RowTitle" />
        <TextView android:id="@+id/pack_size" style="@style/Ink.RowSub" />
    </LinearLayout>
    <ProgressBar android:id="@+id/pack_progress" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone" />
    <TextView
        android:id="@+id/pack_action"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/ink_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
