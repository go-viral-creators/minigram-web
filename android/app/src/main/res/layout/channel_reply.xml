<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/colorSurface">
	<LinearLayout
		android:id="@+id/linear24"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:background="@color/colorSurface"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:elevation="4dp">
		<TextView
			android:id="@+id/btn_back"
			android:layout_width="52dp"
			android:layout_height="match_parent"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:gravity="center_horizontal|center_vertical"
			android:text="arrow_back"
			android:textSize="22sp"
			android:textColor="@color/ink_text"
			android:fontFamily="@font/material_icons"
			android:focusable="true" />
		<TextView
			android:id="@+id/txt_title"
			android:focusable="false"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="Replies"
			android:textSize="18sp"
			android:textStyle="bold"
			android:textColor="@color/ink_text"
			android:layout_weight="1"
			android:maxLines="1"
			android:ellipsize="end" />
	</LinearLayout>
	<FrameLayout
		android:id="@+id/frame_layout25"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">
		<TextView
			android:id="@+id/txt_empty"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_horizontal|center_vertical"
			android:text="No replies yet.\nBe the first to reply!"
			android:textSize="15sp"
			android:textColor="@color/ink_text_2"
			android:lineSpacingMultiplier="1.5"
			android:visibility="visible" />
		<ListView
			android:id="@+id/listview1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:choiceMode="none"
			android:divider="@null"
			android:scrollbars="none"
			android:clipToPadding="false"
			android:visibility="gone" />
	</FrameLayout>
	<View
		android:id="@+id/view26"
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="#2C2C2E" />
	<LinearLayout
		android:id="@+id/linear27"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="8dp"
		android:paddingBottom="8dp"
		android:background="@color/colorSurface"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="12dp"
		android:paddingEnd="8dp">
		<EditText
			android:id="@+id/edit_reply"
			android:focusable="true"
			android:layout_width="0dp"
            android:minHeight="44dp"
			android:layout_height="wrap_content"
			android:paddingTop="10dp"
			android:paddingBottom="10dp"
			android:background="@drawable/input_bubble_bg"
			android:textSize="15sp"
			android:textColor="@color/ink_text"
			android:hint="Write a reply…"
			android:textColorHint="@color/ink_text_2"
			android:layout_weight="1"
			android:inputType="textCapSentences|textMultiLine"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:maxLines="4"
			android:minLines="1" />
		<TextView
			android:id="@+id/btn_send"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:gravity="center_horizontal|center_vertical"
			android:text="send"
			android:textSize="22sp"
			android:textColor="@color/ink_accent"
			android:layout_marginStart="6dp"
			android:fontFamily="@font/material_icons"
			android:focusable="true" />
	</LinearLayout>
</LinearLayout>
