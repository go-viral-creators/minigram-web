<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingLeft="4dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="4dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="arrow_back"
                android:textSize="24sp"
                android:textColor="#000000"
                android:fontFamily="@font/material_icons" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="Channel Info"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- One ScrollView owns the header, the tab bar AND the tab
                 content, exactly like my_profile.xml. Previously the tab
                 content lived in a separate weighted FrameLayout below this,
                 so it was locked to a fixed slice of the screen and long
                 lists could never be scrolled through fully. -->
            <ScrollView
                android:id="@+id/scroll_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <!-- ── Header: photo, name, badge, subtitle ────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:background="#FFFFFF"
                        android:paddingTop="28dp"
                        android:paddingBottom="20dp"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp">

                        <ImageView
                            android:id="@+id/img_channel_photo"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/circle_grey_bg" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txt_channel_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="21sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:maxLines="2"
                                android:gravity="center" />

                            <ImageView
                                android:id="@+id/img_verified_badge"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginLeft="4dp"
                                android:src="@drawable/ic_verified_badge"
                                android:visibility="gone" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txt_sub_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/txt_handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textColor="#229ED9" />

                        <!-- Not subscribed yet (never shown to the owner): one
                             prominent CTA. -->
                        <TextView
                            android:id="@+id/btn_join_big"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:text="Join Channel"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#229ED9"
                            android:background="@drawable/plan_card_bg"
                            android:visibility="gone" />

                        <!-- Subscribed OR owner: Telegram-style icon-button
                             row. action_leave doubles as "Edit" for the
                             owner — see _updateSubscribedUI(). -->
                        <LinearLayout
                            android:id="@+id/row_icon_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal"
                            android:visibility="gone">


                            <LinearLayout
                                android:id="@+id/action_mute"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical"
                                android:gravity="center" android:background="?attr/selectableItemBackground">
                                <TextView
                                    android:id="@+id/icon_mute"
                                    android:layout_width="44dp" android:layout_height="44dp"
                                    android:gravity="center" android:text="notifications" android:textSize="20sp"
                                    android:textColor="#229ED9" android:background="@drawable/circle_bg"
                                    android:backgroundTint="#E8F5FC" android:fontFamily="@font/material_icons" />
                                <TextView
                                    android:id="@+id/txt_mute_label"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:text="Mute" android:textSize="12sp"
                                    android:textColor="#229ED9" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/action_search"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical"
                                android:gravity="center" android:background="?attr/selectableItemBackground">
                                <TextView
                                    android:layout_width="44dp" android:layout_height="44dp"
                                    android:gravity="center" android:text="search" android:textSize="20sp"
                                    android:textColor="#229ED9" android:background="@drawable/circle_bg"
                                    android:backgroundTint="#E8F5FC" android:fontFamily="@font/material_icons" />
                                <TextView
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:text="Search" android:textSize="12sp"
                                    android:textColor="#229ED9" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/action_share"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical"
                                android:gravity="center" android:background="?attr/selectableItemBackground">
                                <TextView
                                    android:layout_width="44dp" android:layout_height="44dp"
                                    android:gravity="center" android:text="share" android:textSize="20sp"
                                    android:textColor="#229ED9" android:background="@drawable/circle_bg"
                                    android:backgroundTint="#E8F5FC" android:fontFamily="@font/material_icons" />
                                <TextView
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:text="Share" android:textSize="12sp"
                                    android:textColor="#229ED9" />
                            </LinearLayout>

                            <!-- Leave (subscriber) / Edit Channel (owner) —
                                 icon+label text swapped at runtime, see
                                 _updateSubscribedUI(). -->
                            <LinearLayout
                                android:id="@+id/action_leave"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical"
                                android:gravity="center" android:background="?attr/selectableItemBackground">
                                <TextView
                                    android:id="@+id/icon_leave_edit"
                                    android:layout_width="44dp" android:layout_height="44dp"
                                    android:gravity="center" android:text="logout" android:textSize="20sp"
                                    android:textColor="#FF3B30" android:background="@drawable/circle_bg"
                                    android:backgroundTint="#FDEAEA" android:fontFamily="@font/material_icons" />
                                <TextView
                                    android:id="@+id/txt_leave_edit_label"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:text="Leave" android:textSize="12sp"
                                    android:textColor="#FF3B30" />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                    <!-- ── Description card ─────────────────────────────────── -->
                    <LinearLayout
                        android:id="@+id/row_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:background="@drawable/plan_card_bg"
                        android:backgroundTint="#FFFFFF"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/txt_bio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="#000000"
                            android:lineSpacingExtra="2dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Description"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E" />
                    </LinearLayout>

                    <!-- ── Blur Notification Image ──────────────────────────── -->
                    <LinearLayout
                        android:id="@+id/row_blur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:background="@drawable/plan_card_bg"
                        android:backgroundTint="#FFFFFF"
                        android:padding="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="28dp" android:layout_height="wrap_content"
                            android:text="blur_on" android:textSize="20sp" android:textColor="#229ED9"
                            android:fontFamily="@font/material_icons" />
                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Blur Notification Image" android:textSize="14sp" android:textColor="#000000" />
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Hide post images in notification previews" android:textSize="11sp" android:textColor="#757575" />
                        </LinearLayout>
                        <Switch android:id="@+id/sw_blur" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- ── Subscribers — owner/admin only, Requirement 4 follow-up.
                         Hidden by default; shown only once _loadChannelInfo()
                         confirms the viewer is owner or admin. ────────────── -->
                    <LinearLayout
                        android:id="@+id/row_subscribers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:background="@drawable/plan_card_bg"
                        android:backgroundTint="#FFFFFF"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="28dp" android:layout_height="wrap_content"
                            android:text="group" android:textSize="20sp" android:textColor="#229ED9"
                            android:fontFamily="@font/material_icons" />
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="10dp"
                            android:text="Subscribers" android:textSize="14sp" android:textColor="#000000" />
                        <TextView
                            android:id="@+id/txt_subscribers_count"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            android:textSize="14sp" android:textColor="#757575" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="chevron_right" android:textSize="22sp" android:textColor="#BDBDBD"
                            android:fontFamily="@font/material_icons" />
                    </LinearLayout>

                    <!-- ── Tab bar — Media / Links / Voice ──────────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:background="@drawable/plan_card_bg"
                        android:backgroundTint="#FFFFFF"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tab_media"
                            android:layout_width="0dp" android:layout_height="46dp"
                            android:layout_weight="1" android:gravity="center"
                            android:background="?attr/selectableItemBackground">
                            <TextView android:id="@+id/txt_tab_media" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Media"
                                android:textSize="13sp" android:textColor="#229ED9" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tab_links"
                            android:layout_width="0dp" android:layout_height="46dp"
                            android:layout_weight="1" android:gravity="center"
                            android:background="?attr/selectableItemBackground">
                            <TextView android:id="@+id/txt_tab_links" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Links"
                                android:textSize="13sp" android:textColor="#9E9E9E" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tab_voice"
                            android:layout_width="0dp" android:layout_height="46dp"
                            android:layout_weight="1" android:gravity="center"
                            android:background="?attr/selectableItemBackground">
                            <TextView android:id="@+id/txt_tab_voice" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Voice"
                                android:textSize="13sp" android:textColor="#9E9E9E" />
                        </LinearLayout>

                    </LinearLayout>
                    <View
                        android:id="@+id/tab_indicator"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginLeft="16dp"
                        android:background="#229ED9" />

                <!-- ── Tab content — now INSIDE the scroll, sized to its
                     content so the whole page scrolls as one. The Activity
                     sets nestedScrollingEnabled=false on this RecyclerView
                     so it measures fully instead of fighting the parent
                     for scroll events. ─────────────────────────────────── -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="220dp"
                    android:background="#FFFFFF">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_tab_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="8dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:clipToPadding="false"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progress_tab_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_tab_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/txt_tab_empty_icon"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="photo_library" android:textSize="40sp" android:textColor="#DDDDDD"
                        android:fontFamily="@font/material_icons" android:gravity="center" />
                    <TextView
                        android:id="@+id/txt_tab_empty_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Nothing here yet"
                        android:textSize="13sp" android:textColor="#9E9E9E" />
                </LinearLayout>

                </FrameLayout>

                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </LinearLayout>

    <!-- ── Selection-mode contextual bar — overlaid on top, Requirement 3's
         View/Forward/Delete pattern reused here for the channel's own
         Media/Links/Voice tabs. ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#229ED9"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_selection_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:text="close"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/material_icons"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/txt_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:text="1 selected"
            android:textSize="16sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btn_selection_view"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="visibility"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/material_icons"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btn_selection_forward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="forward"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/material_icons"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btn_selection_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="8dp"
            android:gravity="center"
            android:text="delete"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/material_icons"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</FrameLayout>
