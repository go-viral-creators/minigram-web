<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="end"
	android:paddingTop="2dp"
	android:paddingBottom="2dp"
	android:paddingLeft="64dp"
	android:paddingRight="12dp"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear77"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/msg_sent_bg"
		android:orientation="vertical"
		android:minWidth="60dp"
		android:elevation="1dp"
		android:clipToOutline="true">
		<LinearLayout
			android:id="@+id/layout_reply_quote"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="6dp"
			android:padding="6dp"
			android:background="@drawable/reply_quote_sent_bg"
			android:orientation="horizontal"
			android:minWidth="180dp"
			android:visibility="gone">
			<View
				android:id="@+id/view42"
				android:layout_width="3dp"
				android:layout_height="match_parent"
				android:layout_marginRight="8dp"
				android:background="@color/colorReplyAccentSent" />
			<TextView
				android:id="@+id/txt_reply_quote"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Original"
				android:textSize="12sp"
				android:textColor="@color/colorReplyAccentSent"
				android:maxLines="2"
				android:ellipsize="end"
				android:focusable="false" />
		</LinearLayout>
		<FrameLayout
			android:id="@+id/frame_layout43"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content">
			<ImageView
				android:id="@+id/img_msg"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="5dp"
				android:layout_marginTop="5dp"
				android:layout_marginRight="5dp"
				android:src="@drawable/ic_image"
				android:scaleType="fitXY"
				android:adjustViewBounds="false"
				android:minWidth="100dp"
				android:minHeight="100dp"
				android:clipToOutline="true"
				android:visibility="gone"
				android:focusable="false" />
			<ProgressBar
				android:id="@+id/img_loading"
				android:focusable="false"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:indeterminate="true"
				style="?android:progressBarStyle"
				android:layout_gravity="center_horizontal|center_vertical"
				android:visibility="gone" />
			<TextView
				android:id="@+id/btn_download_image"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:layout_gravity="center_horizontal|center_vertical"
				android:background="@drawable/circle_download_bg"
				android:gravity="center"
				android:text="file_download"
				android:textSize="22sp"
				android:textColor="#FFFFFF"
				android:fontFamily="@font/material_icons"
				android:visibility="gone" />
			<TextView
				android:id="@+id/txt_time_image"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_margin="6dp"
				android:paddingLeft="6dp"
				android:paddingTop="2dp"
				android:paddingRight="6dp"
				android:paddingBottom="2dp"
				android:background="@drawable/time_badge_bg"
				android:text="12:00"
				android:textSize="10sp"
				android:textColor="#FFFFFF"
				android:layout_gravity="bottom|end"
				android:visibility="gone"
				android:focusable="false" />
		</FrameLayout>
		<LinearLayout
			android:id="@+id/layout_voice_msg"
			android:layout_width="200dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
			android:paddingLeft="10dp"
			android:paddingRight="10dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:visibility="gone">
			<TextView
				android:id="@+id/btn_voice_play"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginRight="6dp"
				android:background="@drawable/circle_primary_bg"
				android:gravity="center"
				android:text="play_arrow"
				android:textSize="20sp"
				android:textColor="#FFFFFF"
				android:fontFamily="@font/material_icons" />
			<SeekBar
				android:id="@+id/seek_voice"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:max="100"
				android:progress="0"
				android:focusable="false" />
			<TextView
				android:id="@+id/txt_voice_duration"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="6dp"
				android:text="0:00"
				android:textSize="11sp"
				android:textColor="@color/ink_on_sent_2"
				android:focusable="false" />
		</LinearLayout>
		<TextView
			android:id="@+id/txt_caption"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:layout_marginLeft="4dp"
			android:layout_marginRight="4dp"
			android:paddingLeft="4dp"
			android:paddingRight="4dp"
			android:textSize="14sp"
			android:textColor="@color/ink_on_sent"
			android:clickable="false"
			android:visibility="gone"
			android:focusable="false" />
		<TextView
			android:id="@+id/txt_msg"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="6dp"
			android:layout_marginTop="6dp"
			android:layout_marginRight="6dp"
			android:paddingLeft="4dp"
			android:paddingRight="4dp"
			android:text="Message"
			android:textSize="15sp"
			android:textColor="@color/ink_on_sent"
			android:clickable="false"
			android:focusable="false" />
		<LinearLayout
			android:id="@+id/layout_link_preview"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="6dp"
			android:layout_marginRight="6dp"
			android:layout_marginTop="4dp"
			android:orientation="vertical"
			android:background="#22FFFFFF"
			android:visibility="gone">
			<ImageView
				android:id="@+id/img_link_preview"
				android:layout_width="match_parent"
				android:layout_height="120dp"
				android:scaleType="centerCrop"
				android:visibility="gone" />
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="8dp">
				<TextView
					android:id="@+id/txt_link_preview_site"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text=""
					android:textSize="10sp"
					android:textAllCaps="true"
					android:textColor="@color/ink_on_sent_2" />
				<TextView
					android:id="@+id/txt_link_preview_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text=""
					android:textSize="13sp"
					android:textStyle="bold"
					android:maxLines="2"
					android:ellipsize="end"
					android:textColor="@color/ink_on_sent" />
				<TextView
					android:id="@+id/txt_link_preview_desc"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text=""
					android:textSize="12sp"
					android:maxLines="2"
					android:ellipsize="end"
					android:textColor="@color/ink_on_sent_2" />
			</LinearLayout>
		</LinearLayout>
		<TextView
			android:id="@+id/txt_edited_label"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="6dp"
			android:paddingLeft="4dp"
			android:text="edited"
			android:textSize="10sp"
			android:textStyle="italic"
			android:textColor="@color/ink_on_sent_2"
			android:visibility="gone"
			android:focusable="false" />
		<TextView
			android:id="@+id/txt_reactions"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="6dp"
			android:layout_marginRight="6dp"
			android:layout_marginTop="2dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp"
			android:paddingTop="3dp"
			android:paddingBottom="3dp"
			android:background="@drawable/reaction_chip_bg"
			android:text=""
			android:textSize="13sp"
			android:visibility="gone"
			android:focusable="false" />
		<LinearLayout
			android:id="@+id/linear44"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="3dp"
			android:layout_marginLeft="8dp"
			android:layout_marginRight="8dp"
			android:layout_marginBottom="6dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:layout_gravity="end">
			<TextView
				android:id="@+id/txt_pinned_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="4dp"
				android:text="push_pin"
				android:textSize="12sp"
				android:textColor="@color/colorReplyAccentSent"
				android:visibility="gone"
				android:fontFamily="@font/material_icons"
				android:focusable="false" />
			<TextView
				android:id="@+id/txt_time_msg"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="12:00"
				android:textSize="10sp"
				android:textColor="@color/ink_on_sent_2"
				android:focusable="false" />
			<TextView
				android:id="@+id/txt_tick_status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="3dp"
				android:text="check"
				android:textSize="13sp"
				android:textColor="@color/ink_on_sent_2"
				android:fontFamily="@font/material_icons"
				android:focusable="false" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
