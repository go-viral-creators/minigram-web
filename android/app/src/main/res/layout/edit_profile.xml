<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/ink_bg">
	<LinearLayout
		android:id="@+id/linear81"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear180"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="16dp"
			android:paddingTop="10dp"
			android:paddingEnd="16dp"
			android:paddingBottom="6dp">
			<TextView
				android:id="@+id/btn_back"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="@drawable/btn_round_outline"
				android:contentDescription="Back"
				android:fontFamily="@font/material_icons"
				android:gravity="center"
				android:text="arrow_back"
				android:textColor="@color/ink_text"
				android:textSize="24sp" />
			<TextView
				android:id="@+id/textview174"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="14dp"
				android:layout_weight="1"
				android:accessibilityHeading="true"
				android:text="Edit profile"
				android:textAppearance="@style/TextAppearance.Ink.Title" />
			<TextView
				android:id="@+id/btn_save"
				android:layout_width="wrap_content"
				android:layout_height="40dp"
				android:background="@drawable/fab_ink_bg"
				android:contentDescription="Save profile"
				android:gravity="center"
				android:minWidth="76dp"
				android:paddingStart="20dp"
				android:paddingEnd="20dp"
				android:text="Save"
				android:textColor="@color/ink_on_accent"
				android:textSize="15sp"
				android:textStyle="bold" />
		</LinearLayout>
		<View android:id="@+id/view183" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink_line" />
		<ScrollView
			android:id="@+id/vscroll14"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:fillViewport="true"
			android:scrollbars="none">
			<LinearLayout
				android:id="@+id/linear181"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="24dp"
				android:paddingTop="24dp"
				android:paddingEnd="24dp"
				android:paddingBottom="40dp">
				<RelativeLayout
					android:id="@+id/relativelayout11"
					android:layout_width="112dp"
					android:layout_height="112dp"
					android:layout_gravity="center_horizontal">
					<ImageView
						android:id="@+id/img_profile"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:background="@drawable/circle_bg_light"
						android:contentDescription="Profile photo"
						android:scaleType="centerCrop"
						android:src="@drawable/ic_person" />
					<LinearLayout
						android:id="@+id/btn_change_photo"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_alignParentBottom="true"
						android:layout_alignParentEnd="true"
						android:background="@drawable/circle_primary_bg"
						android:contentDescription="Change photo"
						android:elevation="4dp"
						android:gravity="center"
						android:clickable="true"
						android:focusable="true">
						<TextView
							android:id="@+id/textview175"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="@font/material_icons"
							android:importantForAccessibility="no"
							android:text="photo_camera"
							android:textColor="#FFFFFF"
							android:textSize="20sp" />
					</LinearLayout>
				</RelativeLayout>
				<TextView
					android:id="@+id/textview179"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_horizontal"
					android:layout_marginTop="10dp"
					android:text="Tap the camera to change your photo"
					android:textColor="@color/ink_text_2"
					android:textSize="13sp" />
				<TextView android:id="@+id/textview180" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
				<TextView style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Full name" />
				<LinearLayout android:id="@+id/linear182" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:background="@drawable/field_box" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
					<TextView android:id="@+id/textview176" android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="person" android:textColor="@color/ink_text_2" android:textSize="22sp" />
					<EditText android:id="@+id/et_fullname" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@null" android:importantForAutofill="no" android:textColor="@color/ink_text" android:textColorHint="@color/ink_text_2" android:textSize="16sp" android:layout_height="match_parent" android:hint="Your name" android:inputType="textPersonName|textCapWords" android:maxLines="1" />
				</LinearLayout>
				<TextView android:id="@+id/txt_fullname_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink_danger" android:textSize="13sp" android:visibility="gone" />
				<TextView android:id="@+id/textview181" style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Username" />
				<LinearLayout android:id="@+id/linear184" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:background="@drawable/field_box" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
					<TextView android:id="@+id/textview177" android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="alternate_email" android:textColor="@color/ink_text_2" android:textSize="22sp" />
					<EditText android:id="@+id/et_username" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@null" android:importantForAutofill="no" android:textColor="@color/ink_text" android:textColorHint="@color/ink_text_2" android:textSize="16sp" android:layout_height="match_parent" android:hint="username" android:inputType="textNoSuggestions|textVisiblePassword" android:maxLines="1" />
				</LinearLayout>
				<TextView android:id="@+id/txt_username_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink_danger" android:textSize="13sp" android:visibility="gone" />
				<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="4–20 characters: lowercase letters, numbers, underscore" android:textColor="@color/ink_text_2" android:textSize="13sp" />
				<TextView android:id="@+id/textview182" style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Phone number" />
				<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/field_box" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
					<TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="call" android:textColor="@color/ink_text_2" android:textSize="22sp" />
					<EditText android:id="@+id/et_country_code" android:layout_width="64dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:background="@null" android:contentDescription="Country code" android:hint="+91" android:importantForAutofill="no" android:inputType="phone" android:maxLength="5" android:maxLines="1" android:textColor="@color/ink_text" android:textSize="16sp" />
					<View android:layout_width="1dp" android:layout_height="26dp" android:background="@color/ink_line" />
					<EditText android:id="@+id/et_phone" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@null" android:importantForAutofill="no" android:textColor="@color/ink_text" android:textColorHint="@color/ink_text_2" android:textSize="16sp" android:layout_height="match_parent" android:hint="Phone number" android:inputType="phone" android:maxLength="14" android:maxLines="1" />
				</LinearLayout>
				<TextView android:id="@+id/txt_phone_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink_danger" android:textSize="13sp" android:visibility="gone" />
				<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Helps people who have your number find you. It is never shown on your profile." android:textColor="@color/ink_text_2" android:textSize="13sp" />
				<TextView style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Bio" />
				<LinearLayout android:id="@+id/linear186" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:background="@drawable/field_box" android:gravity="top" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
					<TextView android:id="@+id/textview178" android:layout_width="24dp" android:layout_marginTop="16dp" android:layout_height="wrap_content" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="info" android:textColor="@color/ink_text_2" android:textSize="22sp" />
					<EditText android:id="@+id/et_bio" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@null" android:importantForAutofill="no" android:textColor="@color/ink_text" android:textColorHint="@color/ink_text_2" android:textSize="16sp" android:layout_height="wrap_content" android:minHeight="96dp" android:gravity="top" android:paddingTop="16dp" android:paddingBottom="16dp" android:hint="Tell people a little about you" android:inputType="textMultiLine|textCapSentences" android:maxLength="120" />
				</LinearLayout>
				<View android:id="@+id/view185" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" />
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/loadingOverlay"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#80000000"
		android:focusable="true"
		android:clickable="true"
		android:gravity="center"
		android:orientation="vertical"
		android:visibility="gone">
		<LinearLayout
			android:id="@+id/loadingBarCard"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="@drawable/card_bg"
			android:elevation="8dp"
			android:gravity="center"
			android:orientation="vertical"
			android:padding="24dp">
			<ProgressBar
				android:id="@+id/progressbar2"
				style="?android:progressBarStyle"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:indeterminate="true"
				android:indeterminateTint="@color/ink_accent" />
			<TextView
				android:id="@+id/textview2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="Loading..."
				android:textColor="@color/ink_text"
				android:textSize="14sp" />
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
