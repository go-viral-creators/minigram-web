<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen image preview before sending — Telegram/WhatsApp style -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ─── Full-screen preview image ─── -->
    <ImageView
        android:id="@+id/preview_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>

    <!-- ─── Top bar (back + counter) ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="12dp"
        android:background="#99000000">

        <TextView
            android:id="@+id/btn_preview_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="arrow_back"
            android:fontFamily="@font/materialfont"
            android:textSize="24sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/txt_preview_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send Photo"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txt_img_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- ─── Thumbnail strip for multi-image (shown above caption bar) ─── -->
    <HorizontalScrollView
        android:id="@+id/scroll_preview_thumbs"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="74dp"
        android:scrollbars="none"
        android:visibility="gone"
        android:background="#99000000"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <LinearLayout
            android:id="@+id/container_thumbs"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

    </HorizontalScrollView>

    <!-- ─── Bottom bar: caption + send ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#CC000000"
        android:minHeight="56dp">

        <!-- Caption field -->
        <EditText
            android:id="@+id/edit_preview_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Add a caption..."
            android:textColorHint="#66FFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@null"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:imeOptions="actionDone"/>

        <!-- Send button -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_send_btn"/>

            <TextView
                android:id="@+id/btn_preview_send"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="send"
                android:fontFamily="@font/materialfont"
                android:textSize="26sp"
                android:textColor="#FFFFFF"/>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
