<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Back" android:fontFamily="@font/material_icons" android:gravity="center" android:text="arrow_back" android:textColor="@color/ink_text" android:textSize="24sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:accessibilityHeading="true" android:text="Appearance" android:textAppearance="@style/TextAppearance.Ink.Title" />
        </LinearLayout>

        <!-- live preview -->
        <FrameLayout android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/pv_recv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="Aaj shaam 7 baje milte hain?" android:textColor="@color/ink_text" />
                <TextView android:id="@+id/pv_sent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="8dp" android:padding="12dp" android:text="Done, pakka. 👍" android:textColor="@color/ink_on_sent" />
            </LinearLayout>
        </FrameLayout>

        <TextView style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Theme" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/chips_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/theme_system" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System" />
            <com.google.android.material.chip.Chip android:id="@+id/theme_light" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Light" />
            <com.google.android.material.chip.Chip android:id="@+id/theme_dark" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dark" />
        </com.google.android.material.chip.ChipGroup>

        <TextView style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Message text size" />
        <com.google.android.material.slider.Slider android:id="@+id/slider_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="Message text size" android:stepSize="1" android:valueFrom="13" android:valueTo="22" />

        <TextView style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Bubble shape" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/chips_bubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/bubble_sharp" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sharp" />
            <com.google.android.material.chip.Chip android:id="@+id/bubble_round" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rounded" />
            <com.google.android.material.chip.Chip android:id="@+id/bubble_pill" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pill" />
        </com.google.android.material.chip.ChipGroup>

        <TextView style="@style/TextAppearance.Ink.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Chat wallpaper" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/row_wallpapers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset" style="@style/Widget.Ink.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Reset to defaults" />
    </LinearLayout>
</ScrollView>
