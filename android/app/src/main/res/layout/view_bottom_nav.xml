<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
	<!-- shared bottom nav (Settings/Discover); ChatlistActivity inlines its own copy -->
	<!-- BOTTOM NAV: Chats · Discover · Channels · Settings (48dp+ touch targets, top indicator) -->
	<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink_text" android:alpha="0.9" />
	<LinearLayout
		android:id="@+id/nav_root"
		android:layout_width="match_parent"
		android:layout_height="68dp"
		android:background="@color/ink_bg"
		android:orientation="horizontal">
		<LinearLayout
			android:id="@+id/nav_linear83"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:contentDescription="Chats"
			android:clickable="true"
			android:focusable="true"
			android:background="?attr/selectableItemBackground">
			<View
				android:id="@+id/nav_ind_chats"
				android:layout_width="28dp"
				android:layout_height="3dp"
				android:background="@color/ink_accent"
				android:visibility="invisible" />
			<TextView
				android:id="@+id/nav_icon_chats"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="chat_bubble_outline"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/nav_textview73"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="Chats"
				android:textSize="12sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/nav_linear_discover"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:contentDescription="Discover"
			android:clickable="true"
			android:focusable="true"
			android:background="?attr/selectableItemBackground">
			<View
				android:id="@+id/nav_ind_discover"
				android:layout_width="28dp"
				android:layout_height="3dp"
				android:background="@color/ink_accent"
				android:visibility="invisible" />
			<TextView
				android:id="@+id/nav_icon_discover"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="explore"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/nav_textview_discover"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="Discover"
				android:textSize="12sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/nav_linear84"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:contentDescription="Channels"
			android:clickable="true"
			android:focusable="true"
			android:background="?attr/selectableItemBackground">
			<View
				android:id="@+id/nav_ind_channels"
				android:layout_width="28dp"
				android:layout_height="3dp"
				android:background="@color/ink_accent"
				android:visibility="invisible" />
			<TextView
				android:id="@+id/nav_icon_channels"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="campaign"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/nav_textview74"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="Channels"
				android:textSize="12sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/nav_linear85"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:contentDescription="Settings"
			android:clickable="true"
			android:focusable="true"
			android:background="?attr/selectableItemBackground">
			<View
				android:id="@+id/nav_ind_settings"
				android:layout_width="28dp"
				android:layout_height="3dp"
				android:background="@color/ink_accent"
				android:visibility="invisible" />
			<TextView
				android:id="@+id/nav_icon_profile"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="settings"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/nav_textview75"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="Settings"
				android:textSize="12sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
