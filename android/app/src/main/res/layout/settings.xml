<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="#F6F8FA">
	<LinearLayout
		android:id="@+id/linear20"
		android:layout_width="match_parent"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:background="#FFFFFF"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:layout_height="?attr/actionBarSize"
		android:elevation="2dp">
		<TextView
			android:id="@+id/btn_back"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:gravity="center_horizontal|center_vertical"
			android:text="arrow_back"
			android:textSize="24sp"
			android:textColor="#212121"
			android:fontFamily="@font/material_icons" />
		<TextView
			android:id="@+id/textview28"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:text="Settings"
			android:textSize="20sp"
			android:textStyle="bold"
			android:textColor="#212121" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/vscroll4"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scrollbars="none"
		android:overScrollMode="never">
		<LinearLayout
			android:id="@+id/linear21"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<!-- clipChildren=false so the Pro badge can hang outside the
			     avatar's bounds (it sits half-on/half-off the top-left
			     corner) instead of being clipped away. -->
			<LinearLayout
				android:id="@+id/row_my_profile"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="16dp"
				android:padding="14dp"
				android:background="@drawable/plan_card_bg"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:clipChildren="false"
				android:clipToPadding="false"
				android:elevation="1dp">
				<FrameLayout
					android:id="@+id/frame_layout5"
					android:layout_width="52dp"
					android:layout_height="52dp"
					android:clipChildren="false"
					android:clipToPadding="false"
					android:background="@drawable/circle_bg_light">
					<ImageView
						android:id="@+id/img_settings_avatar"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:src="@drawable/default_image"
						android:scaleType="centerCrop" />
					<!-- Pro/verified badge — overlaid on the avatar, top-left,
					     roughly half over the image and half outside it. -->
					<ImageView
						android:id="@+id/img_settings_badge"
						android:layout_width="22dp"
						android:layout_height="22dp"
						android:layout_gravity="top|left"
						android:layout_marginLeft="-7dp"
						android:layout_marginTop="-7dp"
						android:src="@drawable/ic_verified_badge"
						android:elevation="2dp"
						android:visibility="gone" />
				</FrameLayout>
				<LinearLayout
					android:id="@+id/linear6"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginLeft="14dp"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/txt_settings_name"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="#212121" />
					<TextView
						android:id="@+id/txt_settings_username"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="View your profile"
						android:textSize="13sp"
						android:textColor="#9E9E9E" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview9"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="chevron_right"
					android:textSize="26sp"
					android:textColor="#BDBDBD"
					android:fontFamily="@font/material_icons" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/btn_minigram_pro"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="16dp"
				android:layout_marginTop="16dp"
				android:layout_marginRight="16dp"
				android:paddingLeft="16dp"
				android:paddingTop="14dp"
				android:paddingRight="16dp"
				android:paddingBottom="14dp"
				android:background="@drawable/plan_card_highlight_bg"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview10"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:background="@drawable/circle_bg_light"
					android:gravity="center_horizontal|center_vertical"
					android:text="workspace_premium"
					android:textSize="22sp"
					android:textColor="#229ED9"
					android:fontFamily="@font/material_icons" />
				<LinearLayout
					android:id="@+id/linear7"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginLeft="14dp"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview11"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Minigram Pro"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="#212121" />
					<TextView
						android:id="@+id/textview12"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="No ads · Blue tick · All features"
						android:textSize="12sp"
						android:textColor="#616161" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview13"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:text="chevron_right"
					android:textSize="26sp"
					android:textColor="#229ED9"
					android:fontFamily="@font/material_icons" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview29"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="20dp"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="8dp"
				android:text="PREFERENCES"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="#8E8E93" />
			<LinearLayout
				android:id="@+id/linear22"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="16dp"
				android:layout_marginRight="16dp"
				android:background="@drawable/setting_card_bg"
				android:orientation="vertical"
				android:elevation="1dp">
				<LinearLayout
					android:id="@+id/btn_privacy"
					android:layout_width="match_parent"
					android:layout_height="60dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:background="?attr/selectableItemBackground"
					android:gravity="center_vertical">
					<TextView
						android:id="@+id/icon_privacy"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="security"
						android:textSize="22sp"
						android:textColor="#34C759"
						android:fontFamily="@font/material_icons" />
					<TextView
						android:id="@+id/textview31"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginLeft="16dp"
						android:text="Privacy &amp; Security"
						android:textSize="16sp"
						android:textColor="#212121"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/chevron2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="chevron_right"
						android:textSize="32sp"
						android:textColor="#BDBDBD"
						android:fontFamily="@font/material_icons" />
				</LinearLayout>
				<View
					android:id="@+id/view8"
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginLeft="56dp"
					android:layout_marginRight="56dp"
					android:background="#F0F0F0" />
				<LinearLayout
					android:id="@+id/btn_data_storage"
					android:layout_width="match_parent"
					android:layout_height="60dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:background="?attr/selectableItemBackground"
					android:gravity="center_vertical">
					<TextView
						android:id="@+id/textview14"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="data_usage"
						android:textSize="22sp"
						android:textColor="#FF9500"
						android:fontFamily="@font/material_icons" />
					<TextView
						android:id="@+id/textview15"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginLeft="16dp"
						android:text="Data and Storage"
						android:textSize="16sp"
						android:textColor="#212121"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/textview16"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="chevron_right"
						android:textSize="32sp"
						android:textColor="#BDBDBD"
						android:fontFamily="@font/material_icons" />
				</LinearLayout>
			</LinearLayout>
			<TextView
				android:id="@+id/textview32"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="20dp"
				android:layout_marginTop="24dp"
				android:layout_marginBottom="8dp"
				android:text="SUPPORT &amp; ABOUT"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="#8E8E93" />
			<LinearLayout
				android:id="@+id/linear24"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="16dp"
				android:layout_marginRight="16dp"
				android:background="@drawable/setting_card_bg"
				android:orientation="vertical"
				android:elevation="1dp">
				<LinearLayout
					android:id="@+id/btn_about"
					android:layout_width="match_parent"
					android:layout_height="60dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:background="?attr/selectableItemBackground"
					android:gravity="center_vertical">
					<TextView
						android:id="@+id/icon_about"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="info"
						android:textSize="22sp"
						android:textColor="#007AFF"
						android:fontFamily="@font/material_icons" />
					<TextView
						android:id="@+id/textview33"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginLeft="16dp"
						android:text="About Minigram"
						android:textSize="16sp"
						android:textColor="#212121"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/chevron3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="chevron_right"
						android:textSize="32sp"
						android:textColor="#BDBDBD"
						android:fontFamily="@font/material_icons" />
				</LinearLayout>
				<View
					android:id="@+id/view34"
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginLeft="56dp"
					android:layout_marginRight="56dp"
					android:background="#F0F0F0" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/btn_logout"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginLeft="16dp"
				android:layout_marginTop="32dp"
				android:layout_marginRight="16dp"
				android:gravity="center_horizontal|center_vertical"
				android:backgroundTint="#FFF0F0"
				android:elevation="1dp">
				<TextView
					android:id="@+id/textview40"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="8dp"
					android:text="logout"
					android:textSize="20sp"
					android:textColor="#FF3B30"
					android:fontFamily="@font/material_icons" />
				<TextView
					android:id="@+id/textview35"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Log Out"
					android:textSize="16sp"
					android:textStyle="bold"
					android:textColor="#FF3B30" />
			</LinearLayout>
			<TextView
				android:id="@+id/tvDisplayAppVersion"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Minigram v1.0.0"
				android:textSize="12sp"
				android:textColor="#BDBDBD" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
