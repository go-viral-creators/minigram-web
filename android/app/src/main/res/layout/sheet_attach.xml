<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="20dp"
    android:background="@color/ink_surface">
    <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:background="@drawable/circle_bg_light" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:text="Share" android:textAppearance="@style/TextAppearance.Ink.Title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:id="@+id/att_gallery" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="@drawable/attach_tile_bg" android:backgroundTint="#4F46E5" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="image" android:textColor="#FFFFFF" android:textSize="26sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Photos" android:textColor="@color/ink_text" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/att_video" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="@drawable/attach_tile_bg" android:backgroundTint="#DC2626" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="videocam" android:textColor="#FFFFFF" android:textSize="26sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Video" android:textColor="@color/ink_text" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/att_audio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="@drawable/attach_tile_bg" android:backgroundTint="#EA580C" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="headphones" android:textColor="#FFFFFF" android:textSize="26sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Audio" android:textColor="@color/ink_text" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:id="@+id/att_document" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="@drawable/attach_tile_bg" android:backgroundTint="#0284C7" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="description" android:textColor="#FFFFFF" android:textSize="26sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Document" android:textColor="@color/ink_text" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/att_sticker" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="@drawable/attach_tile_bg" android:backgroundTint="#D97706" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="emoji_emotions" android:textColor="#FFFFFF" android:textSize="26sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Stickers" android:textColor="@color/ink_text" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/att_camera_dummy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:visibility="invisible" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="@drawable/attach_tile_bg" android:backgroundTint="#00000000" android:fontFamily="@font/material_icons" android:importantForAccessibility="no" android:text="" android:textColor="#FFFFFF" android:textSize="26sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textColor="@color/ink_text" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="Limits: video 30 MB / 90 s \u00b7 audio 15 MB / 10 min \u00b7 documents 20 MB" android:textColor="@color/ink_text_2" android:textSize="12sp" />
</LinearLayout>
