<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/bubble_container"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/msg_sent_bg"
		android:orientation="vertical"
		android:minWidth="60dp"
		android:elevation="1dp"
		android:clipToOutline="true">
		<LinearLayout
			android:id="@+id/layout_reply_quote"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="6dp"
			android:padding="6dp"
			android:background="@drawable/reply_quote_sent_bg"
			android:orientation="horizontal"
			android:minWidth="180dp"
			android:visibility="gone">
			<View
				android:id="@+id/view9"
				android:layout_width="3dp"
				android:layout_height="match_parent"
				android:layout_marginRight="8dp"
				android:background="@color/ink_ok" />
			<TextView
				android:id="@+id/txt_reply_quote"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="@color/ink_ok"
				android:maxLines="2"
				android:ellipsize="end"
				android:focusable="false" />
		</LinearLayout>
		<FrameLayout
			android:id="@+id/frame_layout43"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content">
			<ImageView
				android:id="@+id/img_msg"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="5dp"
				android:layout_marginTop="5dp"
				android:layout_marginRight="5dp"
				android:src="@drawable/default_image"
				android:scaleType="fitXY"
				android:adjustViewBounds="false"
				android:minWidth="100dp"
				android:minHeight="100dp"
				android:clipToOutline="true"
				android:visibility="gone"
				android:focusable="false" />
			<ProgressBar
				android:id="@+id/img_loading"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:indeterminate="true"
				style="?android:progressBarStyle"
				android:layout_gravity="center_horizontal|center_vertical"
				android:visibility="gone"
				android:focusable="false" />
			<TextView
				android:id="@+id/txt_time_image"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_margin="10dp"
				android:paddingLeft="6dp"
				android:paddingTop="2dp"
				android:paddingRight="6dp"
				android:paddingBottom="2dp"
				android:background="@drawable/time_badge_bg"
				android:text="12:00"
				android:textSize="10sp"
				android:textColor="#FFFFFF"
				android:layout_gravity="bottom|end"
				android:visibility="gone"
				android:focusable="false" />
		</FrameLayout>
		<TextView
			android:id="@+id/txt_caption"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="8dp"
			android:paddingTop="6dp"
			android:paddingRight="8dp"
			android:paddingBottom="2dp"
			android:textSize="14sp"
			android:autoLink="web|email|phone"
			android:linksClickable="true"
			android:textIsSelectable="true"
			android:textColorLink="#1565C0"
			android:lineSpacingExtra="2dp"
			android:focusable="false"
			android:visibility="gone"
			android:breakStrategy="high_quality"
			android:hyphenationFrequency="normal" />
		<TextView
			android:id="@+id/txt_msg"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="8dp"
			android:layout_marginTop="8dp"
			android:layout_marginRight="8dp"
			android:paddingLeft="8dp"
			android:paddingTop="8dp"
			android:paddingRight="8dp"
			android:paddingBottom="2dp"
			android:textSize="15sp"
			android:autoLink="web|email|phone"
			android:linksClickable="true"
			android:textIsSelectable="true"
			android:textColorLink="#1565C0"
			android:lineSpacingExtra="2dp"
			android:maxWidth="280dp"
			android:focusable="false"
			android:breakStrategy="high_quality"
			android:hyphenationFrequency="normal" />
		<TextView
			android:id="@+id/txt_edited_label"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="8dp"
			android:text="edited"
			android:textSize="10sp"
			android:textStyle="italic"
			android:textColor="@color/ink_text_2"
			android:singleLine="true"
			android:visibility="gone"
			android:focusable="false" />
		<LinearLayout
			android:id="@+id/linear44"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="3dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp"
			android:paddingBottom="6dp"
			android:orientation="horizontal"
			android:gravity="center_vertical|end">
			<TextView
				android:id="@+id/txt_pinned_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="4dp"
				android:text="push_pin"
				android:textSize="12sp"
				android:textColor="@color/ink_accent"
				android:fontFamily="@font/material_icons"
				android:visibility="gone"
				android:focusable="false" />
			<TextView
				android:id="@+id/txt_time_msg"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginRight="16dp"
				android:text="12:00"
				android:textSize="10sp"
				android:textColor="@color/ink_text_2"
				android:singleLine="true"
				android:focusable="false" />
		</LinearLayout>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear10"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="3dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:layout_gravity="end">
		<TextView
			android:id="@+id/btn_like"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="4dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:text="favorite_border"
			android:textSize="18sp"
			android:textColor="@color/ink_text_2"
			android:fontFamily="@font/material_icons"
			android:focusable="true" />
		<TextView
			android:id="@+id/txt_like_count"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginRight="8dp"
			android:textSize="11sp"
			android:textColor="@color/ink_text_2"
			android:focusable="false" />
		<TextView
			android:id="@+id/btn_reply"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="4dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:text="chat_bubble_outline"
			android:textSize="18sp"
			android:textColor="@color/ink_text_2"
			android:fontFamily="@font/material_icons"
			android:focusable="true" />
		<TextView
			android:id="@+id/txt_reply_count"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginRight="8dp"
			android:textSize="11sp"
			android:textColor="@color/ink_text_2"
			android:focusable="false" />
		<TextView
			android:id="@+id/txt_view_count"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="0"
			android:textSize="11sp"
			android:textColor="@color/ink_text_2"
			android:drawablePadding="2dp"
			android:fontFamily="sans-serif"
			android:visibility="gone"
			android:focusable="false"
			android:drawableStart="@drawable/ic_views_small" />
	</LinearLayout>
</LinearLayout>
