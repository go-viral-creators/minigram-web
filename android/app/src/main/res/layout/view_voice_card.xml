<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_margin="12dp"
    android:background="@drawable/card_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="Recording"
            android:textAppearance="@style/TextAppearance.Ink.Title" />
        <TextView
            android:id="@+id/pill_encrypted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_ok"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="🔒 Encrypted"
            android:textColor="@color/ink_ok"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <View
            android:id="@+id/dot_rec"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_red_bg" />
        <TextView
            android:id="@+id/txt_rec_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/newsreader"
            android:text="0:00"
            android:textColor="@color/ink_text"
            android:textSize="38sp" />
    </LinearLayout>

    <com.silu.minigram.voice.WaveformView
        android:id="@+id/wave_live"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/txt_rec_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/ink_text_2"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_rec_delete"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_icon_soft_alt"
            android:contentDescription="Discard recording"
            android:fontFamily="@font/material_icons"
            android:gravity="center"
            android:text="delete_outline"
            android:textColor="@color/ink_danger"
            android:textSize="26sp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/btn_rec_pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_icon_soft_alt"
            android:contentDescription="Pause recording"
            android:fontFamily="@font/material_icons"
            android:gravity="center"
            android:text="pause"
            android:textColor="@color/ink_text"
            android:textSize="26sp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/btn_rec_send"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/circle_primary_bg"
            android:contentDescription="Send voice message"
            android:fontFamily="@font/material_icons"
            android:gravity="center"
            android:text="send"
            android:textColor="@color/ink_on_accent"
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Everything is processed on this phone — no cloud."
        android:textColor="@color/ink_text_2"
        android:textSize="13sp" />
</LinearLayout>
