<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <!-- Target avatar + name header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/img_target_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_channel"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_target_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Channel Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0D0D0D"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_target_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Channel"
                android:textSize="12sp"
                android:textColor="#757575" />
        </LinearLayout>

        <!-- Sheet title label (top right) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification Privacy"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:gravity="end" />
    </LinearLayout>

    <!-- ── Blur toggle card ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/card_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:elevation="2dp">

        <!-- Blur row -->
        <LinearLayout
            android:id="@+id/row_blur"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="8dp"
            android:background="?attr/selectableItemBackground"
            android:focusable="true">

            <!-- Icon -->
            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="blur_on"
                android:textSize="22sp"
                android:textColor="#2196F3"
                android:fontFamily="@font/material_icons" />

            <!-- Label + sub -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blur notification images"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/txt_blur_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Images visible normally ✓"
                    android:textSize="12sp"
                    android:textColor="#388E3C" />
            </LinearLayout>

            <!-- Switch -->
            <Switch
                android:id="@+id/sw_blur_images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:checked="false" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="62dp"
            android:background="#F0F0F0" />

        <!-- What this does row (non-clickable, just explanatory) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="image"
                android:textSize="18sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/material_icons" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Collapsed notification"
                    android:textSize="13sp"
                    android:textColor="#424242" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Small blurred thumbnail shown by default"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="zoom_out_map"
                android:textSize="18sp"
                android:textColor="#9E9E9E"
                android:fontFamily="@font/material_icons" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expanded notification"
                    android:textSize="13sp"
                    android:textColor="#424242" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Full blurred image visible on expand"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- ── Info tip card ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/card_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:orientation="horizontal"
        android:gravity="top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="info"
            android:textSize="18sp"
            android:textColor="#1565C0"
            android:fontFamily="@font/material_icons" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="This setting applies only to this channel. Enable it if the channel may share sensitive or adult content — notification images will be blurred to protect your privacy in public spaces."
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- ── Done button ───────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/btn_done"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Done"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/circle_primary_bg"
        android:focusable="true" />

</LinearLayout>
