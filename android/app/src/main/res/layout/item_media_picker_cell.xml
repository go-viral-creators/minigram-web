<?xml version="1.0" encoding="utf-8"?>
<!-- Square grid cell for TelegramMediaPicker.
     Height is set programmatically to match column width for square cells. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Thumbnail Image -->
    <ImageView
        android:id="@+id/img_cell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <!-- Dark scrim when selected -->
    <View
        android:id="@+id/cell_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:visibility="invisible"/>

    <!-- Selection checkmark circle (top-right) — Material icon font -->
    <TextView
        android:id="@+id/overlay_check"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:fontFamily="@font/materialfont"
        android:textSize="22sp"
        android:text="circle"
        android:textColor="#AAFFFFFF"
        android:padding="2dp"/>

    <!-- Selection number badge (shown instead of checkmark when selected) -->
    <TextView
        android:id="@+id/badge_count"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone"/>

    <!-- Camera icon overlay (only for camera tile) -->
    <TextView
        android:id="@+id/camera_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:fontFamily="@font/materialfont"
        android:textSize="44sp"
        android:text="photo_camera"
        android:textColor="#CCFFFFFF"
        android:visibility="gone"/>

    <!-- "Camera" label under icon -->
    <TextView
        android:id="@+id/camera_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="52dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="#99FFFFFF"
        android:text="Camera"
        android:visibility="gone"/>

</FrameLayout>
