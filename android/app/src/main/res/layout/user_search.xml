<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_bg">

    <!-- Search Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:background="@color/ink_surface"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:fontFamily="@font/material_icons"
            android:gravity="center"
            android:text="arrow_back"
            android:textColor="@color/ink_text"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/field_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/material_icons"
                android:importantForAccessibility="no"
                android:text="search"
                android:textColor="@color/ink_text_2"
                android:textSize="22sp" />
            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search by name or @username"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/ink_text"
                android:textColorHint="@color/ink_text_2"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/btn_clear_query"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:fontFamily="@font/material_icons"
                android:gravity="center"
                android:text="close"
                android:textColor="@color/ink_text_2"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ink_line" />

    <!-- Loading indicator -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Searching..."
            android:textSize="14sp"
            android:textColor="@color/ink_text_2" />
    </LinearLayout>

    <!-- Default view (shown while the query box is empty): recent searches
         + popular channels. Scrollable, since both lists can grow. -->
    <ScrollView
        android:id="@+id/layout_recent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ── Recent searches ──────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layout_history_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="20dp"
                android:paddingRight="12dp"
                android:paddingTop="18dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECENT SEARCHES"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_text_2" />
                <TextView
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="CLEAR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_danger"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ── Popular channels (channel mode only) ─────────────────── -->
            <TextView
                android:id="@+id/txt_popular_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="4dp"
                android:text="MOST POPULAR CHANNELS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/ink_text_2"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_popular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txt_recent_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="96dp"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="Start typing to search"
                android:textSize="16sp"
                android:textColor="@color/ink_text_2"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Empty state -->
    <TextView
        android:id="@+id/txt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="96dp"
        android:text="No users found"
        android:textSize="16sp"
        android:textColor="@color/ink_text_2"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Results -->
    <ListView
        android:id="@+id/lv_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:divider="@null"
        android:dividerHeight="0dp" />

</LinearLayout>
