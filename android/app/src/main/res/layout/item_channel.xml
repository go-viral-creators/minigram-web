<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/circle_bg_light">
        <ImageView
            android:id="@+id/img_channel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_channel"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:orientation="vertical"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txt_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Channel Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ink_text"
                android:singleLine="true"
                android:ellipsize="end" />
            <ImageView
                android:id="@+id/img_verified_badge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ic_verified_badge"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/txt_subscribers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0 subscribers"
            android:textSize="13sp"
            android:textColor="@color/ink_text_2" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_owner_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:background="@drawable/badge_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Owner"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/ink_accent"
        android:visibility="gone" />

</LinearLayout>
