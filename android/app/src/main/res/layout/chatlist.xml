<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/ink_bg">

<LinearLayout
	android:id="@+id/content_col"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<!-- TOP HEADER: serif title + two outlined round buttons -->
	<LinearLayout
		android:id="@+id/linear80"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="20dp"
		android:paddingEnd="16dp"
		android:paddingTop="12dp"
		android:paddingBottom="4dp"
		android:background="@color/ink_bg"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/textview72"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Chats"
			android:accessibilityHeading="true"
			android:textAppearance="@style/TextAppearance.Ink.Display" />

		<TextView
			android:id="@+id/icon_search"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="@drawable/btn_round_outline"
			android:contentDescription="Search"
			android:gravity="center"
			android:text="search"
			android:textSize="22sp"
			android:textColor="@color/ink_text"
			android:fontFamily="@font/material_icons" />

		<TextView
			android:id="@+id/icon_menu"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginStart="10dp"
			android:background="@drawable/btn_round_outline"
			android:contentDescription="More options"
			android:gravity="center"
			android:text="more_vert"
			android:textSize="22sp"
			android:textColor="@color/ink_text"
			android:fontFamily="@font/material_icons" />
	</LinearLayout>

	<!-- Filter chips + encryption banner (chat list only) -->
	<LinearLayout
		android:id="@+id/layout_chat_filters"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="@color/ink_bg">

		<HorizontalScrollView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:scrollbars="none"
			android:clipToPadding="false"
			android:paddingStart="20dp"
			android:paddingEnd="20dp">

			<com.google.android.material.chip.ChipGroup
				android:id="@+id/chip_group_filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:singleSelection="true"
				app:selectionRequired="true"
				app:chipSpacingHorizontal="10dp">

				<com.google.android.material.chip.Chip
					android:id="@+id/chip_all"
					style="@style/Widget.Ink.Chip"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true"
					android:text="All" />

				<com.google.android.material.chip.Chip
					android:id="@+id/chip_unread"
					style="@style/Widget.Ink.Chip"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Unread" />

				<com.google.android.material.chip.Chip
					android:id="@+id/chip_channels"
					style="@style/Widget.Ink.Chip"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Channels" />
			</com.google.android.material.chip.ChipGroup>
		</HorizontalScrollView>

		<LinearLayout
			android:id="@+id/banner_e2ee"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="20dp"
			android:layout_marginEnd="20dp"
			android:layout_marginTop="12dp"
			android:layout_marginBottom="8dp"
			android:background="@drawable/card_bg"
			android:gravity="center_vertical"
			android:minHeight="48dp"
			android:orientation="horizontal"
			android:padding="12dp"
			android:visibility="gone">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="@font/material_icons"
				android:text="verified_user"
				android:textColor="@color/ink_ok"
				android:textSize="22sp"
				android:importantForAccessibility="no" />

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:text="Chats with updated contacts are end-to-end encrypted. Keys stay on this phone."
				android:textColor="@color/ink_text_2"
				android:textSize="13sp" />
		</LinearLayout>
	</LinearLayout>

	<!-- Channel filter chips (Channels tab only) -->
	<HorizontalScrollView
		android:id="@+id/layout_channel_filters"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/ink_bg"
		android:clipToPadding="false"
		android:paddingStart="20dp"
		android:paddingEnd="20dp"
		android:scrollbars="none"
		android:visibility="gone">
		<com.google.android.material.chip.ChipGroup
			android:id="@+id/chip_group_channels"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:chipSpacingHorizontal="10dp"
			app:selectionRequired="true"
			app:singleSelection="true">
			<com.google.android.material.chip.Chip android:id="@+id/chip_ch_all" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="All" />
			<com.google.android.material.chip.Chip android:id="@+id/chip_ch_mine" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Created by me" />
			<com.google.android.material.chip.Chip android:id="@+id/chip_ch_joined" style="@style/Widget.Ink.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Joined" />
		</com.google.android.material.chip.ChipGroup>
	</HorizontalScrollView>

	<!-- ══ CONTENT AREA ════════════════════════════════════════════════════ -->
	<FrameLayout
		android:id="@+id/frame_layout81"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<ListView
			android:id="@+id/listview_chats"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingTop="8dp"
			android:choiceMode="none"
			android:scrollbars="none"
			android:divider="@null"
			android:dividerHeight="0dp"
			android:clipToPadding="false" />

		<!-- Updates tab content — hosts UpdatesFragment. A real
		     androidx Fragment (not a content-swap like Chats/Channels),
		     shown/hidden the same way via visibility toggling. -->
		<FrameLayout
			android:id="@+id/frame_updates_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<FrameLayout
			android:id="@+id/frame_discover_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<FrameLayout
			android:id="@+id/frame_settings_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<!-- FAB -->
		<LinearLayout
			android:id="@+id/btn_new_chat"
			android:layout_width="56dp"
			android:layout_height="56dp"
			android:layout_margin="20dp"
			android:background="@drawable/fab_ink_bg"
			android:gravity="center"
			android:layout_gravity="bottom|end"
			android:visibility="gone"
			android:elevation="6dp"
			android:contentDescription="New chat"
			android:clickable="true"
			android:focusable="true">
			<TextView
				android:id="@+id/icon_fab"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="search"
				android:textSize="22sp"
				android:textColor="@color/ink_on_accent"
				android:fontFamily="@font/material_icons" />
		</LinearLayout>

		<!--
		  ══ CHANNEL SUB-TABS (Issue 9) ══════════════════════════════════════
		  Pill-chip style: selected tab has filled blue bg + white text.
		  Sits at the top of the content area, floats over the ListView.
		  Initially GONE; shown only when Channels tab (tab=1) is active.
		  ListView gets paddingTop=60dp when this is visible.
		-->
	<LinearLayout
    android:id="@+id/layout_channel_subtabs"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_gravity="top"
    android:background="@color/ink_surface"
    android:elevation="2dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:visibility="gone">

				<!-- MY CHANNELS pill -->
				<TextView
					android:id="@+id/tab_my_channels"
					android:layout_width="wrap_content"
					android:layout_height="34dp"
					android:layout_marginRight="8dp"
					android:paddingLeft="18dp"
					android:paddingRight="18dp"
					android:gravity="center"
					android:text="My Channels"
					android:textSize="13sp"
                    android:layout_weight="1"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:background="@drawable/tab_pill_active_bg"
					android:focusable="true" />

				<!-- SUBSCRIBED pill -->
				<TextView
					android:id="@+id/tab_subscribed"
					android:layout_width="wrap_content"
					android:layout_height="34dp"
					android:paddingLeft="18dp"
					android:paddingRight="18dp"
					android:gravity="center"
					android:text="Subscribed"
                    android:layout_weight="1"
					android:textSize="13sp"
					android:textColor="#5A5A5A"
					android:background="@drawable/tab_pill_inactive_bg"
					android:focusable="true" />

			</LinearLayout>

	</FrameLayout>
</LinearLayout>

	<!-- Overlay stack: banner ad (when loaded) above a floating pill nav, like Telegram. Content scrolls underneath. -->
	<LinearLayout
		android:id="@+id/overlay_stack"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:orientation="vertical">

		<com.google.android.gms.ads.AdView
			android:id="@+id/banner_ad"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:visibility="gone"
			app:adSize="SMART_BANNER"
			app:adUnitId="ca-app-pub-5237566165900598/8597822077" />

		<LinearLayout
			android:id="@+id/linear82"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="16dp"
			android:layout_marginEnd="16dp"
			android:layout_marginBottom="10dp"
			android:layout_marginTop="6dp"
			android:elevation="0dp"
			android:padding="2dp"
			android:orientation="horizontal"
			android:background="@drawable/nav_pill_bg">
		<LinearLayout
			android:id="@+id/linear83"
			android:layout_width="0dp"
			android:layout_height="56dp"
			android:layout_weight="1"
			android:layout_margin="4dp"
			android:gravity="center"
			android:orientation="vertical"
			android:contentDescription="Chats"
			android:clickable="true"
			android:focusable="true"
			android:background="@drawable/nav_item_bg">
			<TextView
				android:id="@+id/icon_chats"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="chat_bubble_outline"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/textview73"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Chats"
				android:textSize="11sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear_discover"
			android:layout_width="0dp"
			android:layout_height="56dp"
			android:layout_weight="1"
			android:layout_margin="4dp"
			android:gravity="center"
			android:orientation="vertical"
			android:contentDescription="Discover"
			android:clickable="true"
			android:focusable="true"
			android:background="@drawable/nav_item_bg">
			<TextView
				android:id="@+id/icon_discover"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="explore"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/textview_discover"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Discover"
				android:textSize="11sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear84"
			android:layout_width="0dp"
			android:layout_height="56dp"
			android:layout_weight="1"
			android:layout_margin="4dp"
			android:gravity="center"
			android:orientation="vertical"
			android:contentDescription="Channels"
			android:clickable="true"
			android:focusable="true"
			android:background="@drawable/nav_item_bg">
			<TextView
				android:id="@+id/icon_channels"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="campaign"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/textview74"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Channels"
				android:textSize="11sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear85"
			android:layout_width="0dp"
			android:layout_height="56dp"
			android:layout_weight="1"
			android:layout_margin="4dp"
			android:gravity="center"
			android:orientation="vertical"
			android:contentDescription="Settings"
			android:clickable="true"
			android:focusable="true"
			android:background="@drawable/nav_item_bg">
			<TextView
				android:id="@+id/icon_profile"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="settings"
				android:textSize="24sp"
				android:textColor="@color/ink_text_2"
				android:importantForAccessibility="no"
				android:fontFamily="@font/material_icons" />
			<TextView
				android:id="@+id/textview75"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Settings"
				android:textSize="11sp"
				android:textColor="@color/ink_text_2" />
		</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
