<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Ink &amp; Paper: warm paper background, indigo accent, serif headings, small corners -->
        <item name="colorPrimary">@color/ink_accent</item>
        <item name="colorOnPrimary">@color/ink_on_accent</item>
        <item name="colorPrimaryContainer">@color/ink_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/ink_accent</item>
        <item name="colorSecondary">@color/ink_accent</item>
        <item name="colorOnSecondary">@color/ink_on_accent</item>
        <item name="colorSurface">@color/ink_surface</item>
        <item name="colorOnSurface">@color/ink_text</item>
        <item name="colorSurfaceVariant">@color/ink_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/ink_text_2</item>
        <item name="colorOutline">@color/ink_line</item>
        <item name="colorOutlineVariant">@color/ink_line</item>
        <item name="colorError">@color/ink_danger</item>
        <item name="android:colorBackground">@color/ink_bg</item>
        <item name="android:windowBackground">@color/ink_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="shapeAppearanceSmallComponent">@style/Ink.Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Ink.Shape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Ink.Shape.Medium</item>
        <item name="materialAlertDialogTheme">@style/Ink.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
        <item name="android:textColorPrimary">@color/ink_text</item>
        <item name="android:textColorSecondary">@color/ink_text_2</item>
    </style>

    <style name="Ink.Shape.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item><item name="cornerSize">4dp</item>
    </style>
    <style name="Ink.Shape.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item><item name="cornerSize">6dp</item>
    </style>
    <style name="Ink.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Ink.Shape.Medium</item>
        <item name="colorSurface">@color/ink_surface</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <!-- Screen titles / display text: serif -->
    <style name="TextAppearance.Ink.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/newsreader</item>
        <item name="android:textColor">@color/ink_text</item>
        <item name="android:textSize">32sp</item>
    </style>
    <style name="TextAppearance.Ink.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/newsreader</item>
        <item name="android:textColor">@color/ink_text</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.Ink.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/ink_text_2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Ink.Mono" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/jetbrains_mono_var</item>
        <item name="android:textColor">@color/ink_text</item>
    </style>
    <!-- Cards: white, hairline border, 6dp corners -->
    <style name="Widget.Ink.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ink_surface</item>
        <item name="strokeColor">@color/ink_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">6dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <!-- Chips: pills, 48dp touch height -->
    <style name="Widget.Ink.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">40dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipBackgroundColor">@color/ink_chip_bg</item>
        <item name="chipStrokeColor">@color/ink_line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/ink_chip_text</item>
        <item name="chipSurfaceColor">@color/ink_surface</item>
        <item name="shapeAppearanceOverlay">@style/Ink.Shape.Pill</item>
    </style>
    <style name="Ink.Shape.Pill" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">50%</item></style>
    <style name="Widget.Ink.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearanceOverlay">@style/Ink.Shape.Medium</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Ink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/ink_line</item>
        <item name="shapeAppearanceOverlay">@style/Ink.Shape.Medium</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="AppTheme.FullScreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3">
    </style>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3">
    </style>
    <style name="AppTheme.DebugActivity" parent="AppTheme">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>
    <style name="Theme.Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    
    <style name="AppBottomSheetDialogTheme"
    parent="Theme.Material3.DayNight.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/AppModalStyle</item>
    <item name="android:windowIsFloating">false</item>
</style>

<style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
    <item name="android:background">@android:color/transparent</item>
</style>
    <style name="Ink.RowIcon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/circle_icon_soft</item>
        <item name="android:fontFamily">@font/material_icons</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">@color/ink_accent</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="Ink.RowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Ink.RowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Ink.RowSub" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_text_2</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Ink.SwitchRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="AppTheme.Splash" parent="AppTheme" />
</resources>