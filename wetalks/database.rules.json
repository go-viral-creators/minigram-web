{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".indexOn": ["usernameLower", "nameLower"],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "username": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,20}$/) && (data.val() === newData.val() || root.child('usernames').child(newData.val().toLowerCase()).val() === auth.uid)" },
        "usernameLower": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/) && (!newData.parent().child('username').exists() || newData.val() === newData.parent().child('username').val().toLowerCase())" },
        "about": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 60000" },
        "pk": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "phoneKey": { ".validate": "!newData.exists() || (root.child('config').child('phoneKeyLegacyOff').val() !== true && newData.isString())" },
        "$other": { ".validate": "true" }
      }
    },

    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (newData.val() === auth.uid && !data.exists() || !newData.exists() && data.val() === auth.uid)",
        ".validate": "$name.matches(/^[a-z0-9_]{3,20}$/) && newData.isString()"
      }
    },

    "web": {
      "u": { "$n": {
        ".read": true,
        ".write": "auth != null && root.child('usernames').child($n).val() === auth.uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 60)",
        "n": { ".validate": "newData.isString()" },
        "a": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "p": { ".validate": "newData.isString() && newData.val().length <= 40000" },
        "$other": { ".validate": false }
      } },
      "c": { "$h": {
        ".read": true,
        ".write": "auth != null && root.child('channel_handles').child($h).exists() && root.child('channels').child(root.child('channel_handles').child($h).val()).child('owner').val() === auth.uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 60)",
        "n": { ".validate": "newData.isString()" },
        "a": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "p": { ".validate": "newData.isString() && newData.val().length <= 40000" },
        "s": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      } }
    },

    "service_inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$mid": {
          ".write": "auth != null && ((auth.uid === $uid && data.exists() && !newData.exists()) || (root.child('config').child('relay').val() === auth.uid && !data.exists() && newData.exists() && root.child('privacy').child($uid).child('services').val() !== 'nobody' && !root.child('service_blocks').child($uid).child(newData.child('a').val()).exists()))",
          ".validate": "!newData.exists() || newData.hasChildren(['a','an','k','x','ts'])",
          "a": { ".validate": "newData.isString() && newData.val().matches(/^app_[a-f0-9]{12}$/)" },
          "an": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 32" },
          "v": { ".validate": "newData.val() === 0 || newData.val() === 1" },
          "k": { ".validate": "newData.val() === 'info' || newData.val() === 'alert' || newData.val() === 'followup' || newData.val() === 'otp'" },
          "t": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "x": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
          "l": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^https:\\/\\/.*/)" },
          "o": { ".validate": "newData.val() === 1" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "service_blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$app": { ".write": "auth != null && auth.uid === $uid", ".validate": "$app.matches(/^app_[a-f0-9]{12}$/) && newData.val() === true" }
      }
    },

    "config": {
      "maintenance": { ".read": true, ".write": false }
    },

    "fcm_tokens": {
      "$uid": {
        "$token": { ".write": "auth != null && auth.uid === $uid", ".validate": "$token.length >= 20 && $token.length <= 400 && (newData.isNumber() || !newData.exists())" }
      }
    },

    "blocks": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" } },

    "user_chats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid || root.child('groups').child($cid).child('members').child(auth.uid).exists())))",
          "type": { ".write": "auth != null && auth.uid !== $uid && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('members').child($uid).exists()))", ".validate": "newData.isString() && (newData.val() === 'dm' || newData.val() === 'group' || newData.val() === 'channel')" },
          "peer": { ".write": "auth != null && auth.uid !== $uid && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid)", ".validate": "newData.isString() && newData.val().length <= 128 && (auth.uid === $uid || newData.val() === auth.uid)" },
          "lastTs": { ".write": "auth != null && auth.uid !== $uid && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('members').child($uid).exists()))", ".validate": "newData.isNumber()" },
          "lastBody": { ".write": "auth != null && auth.uid !== $uid && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('members').child($uid).exists()))", ".validate": "newData.isString() && newData.val().length <= 60000" },
          "lastType": { ".write": "auth != null && auth.uid !== $uid && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('members').child($uid).exists()))", ".validate": "newData.isString() && newData.val().length <= 24" },
          "lastFrom": { ".write": "auth != null && auth.uid !== $uid && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('members').child($uid).exists()))", ".validate": "newData.isString() && newData.val().length <= 128" },
          "unread": { ".write": "auth != null && auth.uid !== $uid && ($cid === $uid + '_' + auth.uid || $cid === auth.uid + '_' + $uid || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('members').child($uid).exists()))", ".validate": "newData.isNumber() && newData.val() >= 0 && (auth.uid === $uid || newData.val() === 0 || (!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)" },
          "pinned": { ".validate": "newData.isBoolean()" },
          "muted": { ".validate": "newData.isBoolean()" },
          "archived": { ".validate": "newData.isBoolean()" },
          "labels": { "$lid": { ".validate": "$lid.matches(/^[a-z0-9]{6,12}$/) && newData.val() === true" } },
          "$other": { ".validate": false }
        }
      }
    },

    "chat_labels": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$lid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$lid.matches(/^[a-z0-9]{6,12}$/) && (!newData.exists() || (newData.hasChildren(['name','color']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 24 && newData.child('color').isNumber() && newData.child('color').val() >= 0 && newData.child('color').val() <= 11))",
          "name": { ".validate": "newData.isString()" },
          "color": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peer": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.val() === true" }
      }
    },

    "groups": {
      "$gid": {
        ".read": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
        "name": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'", ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "about": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'" },
        "photo": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'", ".validate": "newData.isString() && newData.val().length <= 60000" },
        "kv": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'" },
        "perms": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'" },
        "slow": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'", ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
        "members": {
          ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'",
          "$m": {
            ".write": "auth != null && ((root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin') || (auth.uid === $m && !newData.exists()))",
            ".validate": "!newData.exists() || ((newData.val() === 'admin' || newData.val() === 'member') && (data.exists() || $m === auth.uid || (root.child('privacy').child($m).child('groups').val() !== 'nobody' && (root.child('privacy').child($m).child('groups').val() !== 'contacts' || root.child('contacts').child($m).child(auth.uid).exists()))))"
          }
        }
      }
    },

    "group_keys": {
      "$gid": {
        "$kv": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'"
          }
        }
      }
    },

    "channels": {
      ".indexOn": ["handleLower", "nameLower", "subCount"],
      ".read": "auth != null",
      "$cid": {
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
        "name": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "nameLower": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "perms": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "slow": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
        "priv": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isBoolean()" },
        "admins": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "about": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "photo": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isString() && newData.val().length <= 60000" },
        "lastTs": { ".write": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists()))" },
        "lastPreview": { ".write": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists()))", ".validate": "newData.isString() && newData.val().length <= 200" },
        "subCount": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 1) || (newData.val() === data.val() + 1 && root.child('channel_subs').child($cid).child(auth.uid).exists()) || (newData.val() === data.val() - 1 && !root.child('channel_subs').child($cid).child(auth.uid).exists()))" }
      }
    },

    "channel_handles": {
      ".read": "auth != null",
      "$h": { ".write": "auth != null && !data.exists() && newData.isString()", ".validate": "$h.matches(/^[a-z0-9_]{3,32}$/)" }
    },

    "channel_subs": {
      "$cid": {
        ".read": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('channels').child($cid).child('priv').val() !== true || (newData.child('t').isString() && (root.child('channel_invites').child($cid).child(newData.child('t').val()).child('exp').val() === 0 || root.child('channel_invites').child($cid).child(newData.child('t').val()).child('exp').val() > now)))",
          ".validate": "newData.val() === true || (newData.hasChildren(['t','ts']) && newData.child('t').isString() && newData.child('t').val().length >= 16 && newData.child('t').val().length <= 32 && newData.child('ts').isNumber())",
          "t": { ".validate": "newData.isString()" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "channel_invites": {
      "$cid": {
        ".read": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())",
        "$token": {
          ".write": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())",
          ".validate": "$token.matches(/^[A-Za-z0-9]{16,32}$/) && (!newData.exists() || (newData.hasChildren(['by','exp','created']) && newData.child('by').val() === auth.uid && newData.child('exp').isNumber()))",
          "by": { ".validate": "newData.isString()" },
          "exp": { ".validate": "newData.isNumber()" },
          "created": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "channel_priv": {
      "$cid": {
        ".read": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || root.child('channel_subs').child($cid).child(auth.uid).exists())",
        "lastTs": { ".write": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists()))", ".validate": "newData.isNumber()" },
        "lastPreview": { ".write": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists()))", ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other": { ".validate": false }
      }
    },

    "messages": {
      "$cid": {
        ".write": "auth != null && !newData.exists() && $cid.contains('_') && $cid.contains(auth.uid)",
        ".read": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || (root.child('channels').child($cid).exists() && (root.child('channels').child($cid).child('priv').val() !== true || root.child('channel_subs').child($cid).child(auth.uid).exists() || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())))",
        "$mid": {
          ".write": "auth != null && ( (!data.exists() && newData.child('from').val() === auth.uid && (($cid.contains('_') && $cid.contains(auth.uid)) || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && (root.child('groups').child($cid).child('members').child(auth.uid).val() === 'admin' || ((root.child('groups').child($cid).child('perms').child('send').val() !== false && (newData.child('type').val() !== 'text' && newData.child('type').val() !== 'link' || root.child('groups').child($cid).child('perms').child('text').val() !== false) && ((newData.child('type').val() !== 'image' && newData.child('type').val() !== 'video' && newData.child('type').val() !== 'audio' && newData.child('type').val() !== 'file') || root.child('groups').child($cid).child('perms').child('image').val() !== false) && (newData.child('type').val() !== 'sticker' && newData.child('type').val() !== 'gif' || root.child('groups').child($cid).child('perms').child('sticker').val() !== false) && (newData.child('type').val() !== 'voice' || root.child('groups').child($cid).child('perms').child('voice').val() !== false)) && (!root.child('groups').child($cid).child('slow').exists() || root.child('groups').child($cid).child('slow').val() == 0 || !root.child('slow').child($cid).child(auth.uid).exists() || now - root.child('slow').child($cid).child(auth.uid).val() >= root.child('groups').child($cid).child('slow').val() * 1000)))) || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists() && (root.child('channels').child($cid).child('perms').child('send').val() !== false && (newData.child('type').val() !== 'text' && newData.child('type').val() !== 'link' || root.child('channels').child($cid).child('perms').child('text').val() !== false) && ((newData.child('type').val() !== 'image' && newData.child('type').val() !== 'video' && newData.child('type').val() !== 'audio' && newData.child('type').val() !== 'file') || root.child('channels').child($cid).child('perms').child('image').val() !== false) && (newData.child('type').val() !== 'sticker' && newData.child('type').val() !== 'gif' || root.child('channels').child($cid).child('perms').child('sticker').val() !== false) && (newData.child('type').val() !== 'voice' || root.child('channels').child($cid).child('perms').child('voice').val() !== false)) && (!root.child('channels').child($cid).child('slow').exists() || root.child('channels').child($cid).child('slow').val() == 0 || !root.child('slow').child($cid).child(auth.uid).exists() || now - root.child('slow').child($cid).child(auth.uid).val() >= root.child('channels').child($cid).child('slow').val() * 1000)))) || (data.exists() && newData.exists() && data.child('from').val() === auth.uid && newData.child('from').val() === auth.uid && newData.child('type').val() === data.child('type').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('kv').val() === data.child('kv').val()) || (data.exists() && !newData.exists() && (data.child('from').val() === auth.uid || ($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).val() === 'admin' || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())) )",
          ".validate": "!newData.exists() || (newData.hasChildren(['from','ts','type','body']) && newData.child('body').isString() && newData.child('body').val().length <= 60000)",
          "react": {
            "$ruid": { ".write": "auth != null && auth.uid === $ruid && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || (root.child('channels').child($cid).exists() && (root.child('channels').child($cid).child('priv').val() !== true || root.child('channel_subs').child($cid).child(auth.uid).exists() || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())))", ".validate": "newData.isString() && newData.val().length <= 8" }
          }
        }
      }
    },

    "calls": {
      "$cid": {
        ".read": "auth != null && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['from','to','ts','state'])"
      }
    },

    "incoming_calls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cid": { ".write": "auth != null && (auth.uid === $uid || newData.child('from').val() === auth.uid)" }
      }
    },

    "pins": {
      "$cid": {
        ".write": "auth != null && !newData.exists() && $cid.contains('_') && $cid.contains(auth.uid)",
        ".read": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || (root.child('channels').child($cid).exists() && (root.child('channels').child($cid).child('priv').val() !== true || root.child('channel_subs').child($cid).child(auth.uid).exists() || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())))",
        "$mid": {
          ".write": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).val() === 'admin' || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('perms').child('pin').val() === true) || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())"
        }
      }
    },

    "privacy": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$k": { ".validate": "newData.isString() && (newData.val() === 'all' || newData.val() === 'contacts' || newData.val() === 'nobody')" }
      }
    },

    "presence": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "online": { ".read": "auth != null && (auth.uid === $uid || !root.child('blocks').child($uid).child(auth.uid).exists() && (root.child('privacy').child($uid).child('online').val() === 'all' || (root.child('privacy').child($uid).child('online').val() === 'contacts' && (root.child('contacts').child($uid).child(auth.uid).exists() || root.child('reads').child($uid + '_' + auth.uid).child($uid).exists() || root.child('reads').child(auth.uid + '_' + $uid).child($uid).exists())) || !root.child('privacy').child($uid).child('online').exists()))" },
        "lastSeen": { ".read": "auth != null && (auth.uid === $uid || !root.child('blocks').child($uid).child(auth.uid).exists() && (root.child('privacy').child($uid).child('lastSeen').val() === 'all' || (root.child('privacy').child($uid).child('lastSeen').val() === 'contacts' && (root.child('contacts').child($uid).child(auth.uid).exists() || root.child('reads').child($uid + '_' + auth.uid).child($uid).exists() || root.child('reads').child(auth.uid + '_' + $uid).child($uid).exists())) || !root.child('privacy').child($uid).child('lastSeen').exists()))" }
      }
    },

    "contact_info": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "phone": { ".read": "auth != null && (auth.uid === $uid || !root.child('blocks').child($uid).child(auth.uid).exists() && (root.child('privacy').child($uid).child('phone').val() === 'all' || (root.child('privacy').child($uid).child('phone').val() === 'contacts' && (root.child('contacts').child($uid).child(auth.uid).exists() || root.child('reads').child($uid + '_' + auth.uid).child($uid).exists() || root.child('reads').child(auth.uid + '_' + $uid).child($uid).exists()))))", ".validate": "newData.isString() && newData.val().length <= 20" }
      }
    },

    "key_backups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['s','i','c','pub']) && newData.child('c').isString() && newData.child('c').val().length <= 400"
      }
    },

    "slow": {
      "$cid": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid && newData.isNumber() && (!data.exists() || newData.val() >= data.val())" } }
    },

    "phone_keys": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/))"
      }
    },

    "phones": {
      "$h": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.val() === auth.uid || data.val() === auth.uid)",
        ".validate": "$h.matches(/^[a-f0-9]{32}$/) && newData.isString()"
      }
    },

    "typing": {
      "$cid": {
        ".read": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || (root.child('channels').child($cid).exists() && (root.child('channels').child($cid).child('priv').val() !== true || root.child('channel_subs').child($cid).child(auth.uid).exists() || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())))",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    "reads": {
      "$cid": {
        ".read": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || (root.child('channels').child($cid).exists() && (root.child('channels').child($cid).child('priv').val() !== true || root.child('channel_subs').child($cid).child(auth.uid).exists() || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())))",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    "media": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && !newData.exists() && data.child('from').val() === auth.uid",
        ".validate": "!newData.exists()"
      }
    }
  }
}
