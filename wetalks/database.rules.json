{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".indexOn": ["usernameLower", "nameLower"],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "username": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,20}$/)" },
        "usernameLower": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)" },
        "about": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 60000" },
        "pk": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "$other": { ".validate": "true" }
      }
    },

    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (newData.val() === auth.uid && !data.exists() || !newData.exists() && data.val() === auth.uid)",
        ".validate": "$name.matches(/^[a-z0-9_]{3,20}$/) && newData.isString()"
      }
    },

    "config": {
      "maintenance": { ".read": true, ".write": false }
    },

    "fcm_tokens": {
      "$uid": {
        "$token": { ".write": "auth != null && auth.uid === $uid", ".validate": "$token.length >= 20 && $token.length <= 400 && (newData.isNumber() || !newData.exists())" }
      }
    },

    "blocks": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" } },

    "user_chats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cid": {
          ".write": "auth != null && (auth.uid === $uid || ($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists())"
        }
      }
    },

    "groups": {
      "$gid": {
        ".read": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
        "name": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'", ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "about": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'" },
        "photo": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'", ".validate": "newData.isString() && newData.val().length <= 60000" },
        "kv": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'" },
        "perms": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'" },
        "slow": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'", ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
        "members": {
          ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'",
          "$m": { ".write": "auth != null && ((root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin') || (auth.uid === $m && !newData.exists()))" }
        }
      }
    },

    "group_keys": {
      "$gid": {
        "$kv": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).val() === 'admin'"
          }
        }
      }
    },

    "channels": {
      ".indexOn": ["handleLower", "nameLower", "subCount"],
      ".read": "auth != null",
      "$cid": {
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
        "name": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "nameLower": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "perms": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "slow": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
        "priv": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isBoolean()" },
        "admins": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "about": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid" },
        "photo": { ".write": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid", ".validate": "newData.isString() && newData.val().length <= 60000" },
        "lastTs": { ".write": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists()))" },
        "lastPreview": { ".write": "auth != null && (root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists()))", ".validate": "newData.isString() && newData.val().length <= 200" },
        "subCount": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1 || newData.val() === data.val() - 1)" }
      }
    },

    "channel_handles": {
      ".read": "auth != null",
      "$h": { ".write": "auth != null && !data.exists() && newData.isString()", ".validate": "$h.matches(/^[a-z0-9_]{3,32}$/)" }
    },

    "channel_subs": {
      "$cid": {
        ".read": "auth != null && root.child('channels').child($cid).child('owner').val() === auth.uid",
        "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" }
      }
    },

    "messages": {
      "$cid": {
        ".write": "auth != null && !newData.exists() && $cid.contains('_') && $cid.contains(auth.uid)",
        ".read": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || root.child('channels').child($cid).exists())",
        "$mid": {
          ".write": "auth != null && ( (!data.exists() && newData.child('from').val() === auth.uid && (($cid.contains('_') && $cid.contains(auth.uid)) || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && (root.child('groups').child($cid).child('members').child(auth.uid).val() === 'admin' || ((root.child('groups').child($cid).child('perms').child('send').val() !== false && (newData.child('type').val() !== 'text' && newData.child('type').val() !== 'link' || root.child('groups').child($cid).child('perms').child('text').val() !== false) && (newData.child('type').val() !== 'image' || root.child('groups').child($cid).child('perms').child('image').val() !== false) && (newData.child('type').val() !== 'sticker' && newData.child('type').val() !== 'gif' || root.child('groups').child($cid).child('perms').child('sticker').val() !== false) && (newData.child('type').val() !== 'voice' || root.child('groups').child($cid).child('perms').child('voice').val() !== false)) && (!root.child('groups').child($cid).child('slow').exists() || root.child('groups').child($cid).child('slow').val() == 0 || !root.child('slow').child($cid).child(auth.uid).exists() || now - root.child('slow').child($cid).child(auth.uid).val() >= root.child('groups').child($cid).child('slow').val() * 1000)))) || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists() || (root.child('channels').child($cid).child('perms').child('followers').val() === true && root.child('channel_subs').child($cid).child(auth.uid).exists() && (root.child('channels').child($cid).child('perms').child('send').val() !== false && (newData.child('type').val() !== 'text' && newData.child('type').val() !== 'link' || root.child('channels').child($cid).child('perms').child('text').val() !== false) && (newData.child('type').val() !== 'image' || root.child('channels').child($cid).child('perms').child('image').val() !== false) && (newData.child('type').val() !== 'sticker' && newData.child('type').val() !== 'gif' || root.child('channels').child($cid).child('perms').child('sticker').val() !== false) && (newData.child('type').val() !== 'voice' || root.child('channels').child($cid).child('perms').child('voice').val() !== false)) && (!root.child('channels').child($cid).child('slow').exists() || root.child('channels').child($cid).child('slow').val() == 0 || !root.child('slow').child($cid).child(auth.uid).exists() || now - root.child('slow').child($cid).child(auth.uid).val() >= root.child('channels').child($cid).child('slow').val() * 1000)))) || (data.exists() && newData.exists() && data.child('from').val() === auth.uid && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('from').val() === auth.uid || ($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).val() === 'admin' || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())) )",
          ".validate": "!newData.exists() || (newData.hasChildren(['from','ts','type','body']) && newData.child('body').isString() && newData.child('body').val().length <= 60000)",
          "react": {
            "$ruid": { ".write": "auth != null && auth.uid === $ruid && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || root.child('channels').child($cid).exists())", ".validate": "newData.isString() && newData.val().length <= 8" }
          }
        }
      }
    },

    "calls": {
      "$cid": {
        ".read": "auth != null && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['from','to','ts','state'])"
      }
    },

    "incoming_calls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cid": { ".write": "auth != null && (auth.uid === $uid || newData.child('from').val() === auth.uid)" }
      }
    },

    "pins": {
      "$cid": {
        ".write": "auth != null && !newData.exists() && $cid.contains('_') && $cid.contains(auth.uid)",
        ".read": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).exists() || root.child('channels').child($cid).exists())",
        "$mid": {
          ".write": "auth != null && (($cid.contains('_') && $cid.contains(auth.uid)) || root.child('groups').child($cid).child('members').child(auth.uid).val() === 'admin' || (root.child('groups').child($cid).child('members').child(auth.uid).exists() && root.child('groups').child($cid).child('perms').child('pin').val() === true) || root.child('channels').child($cid).child('owner').val() === auth.uid || root.child('channels').child($cid).child('admins').child(auth.uid).exists())"
        }
      }
    },

    "privacy": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$k": { ".validate": "newData.isString() && (newData.val() === 'all' || newData.val() === 'contacts' || newData.val() === 'nobody')" }
      }
    },

    "presence": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "online": { ".read": "auth != null && (auth.uid === $uid || root.child('privacy').child($uid).child('online').val() === 'all' || (root.child('privacy').child($uid).child('online').val() === 'contacts' && (root.child('user_chats').child($uid).child($uid + '_' + auth.uid).exists() || root.child('user_chats').child($uid).child(auth.uid + '_' + $uid).exists())) || !root.child('privacy').child($uid).child('online').exists())" },
        "lastSeen": { ".read": "auth != null && (auth.uid === $uid || root.child('privacy').child($uid).child('lastSeen').val() === 'all' || (root.child('privacy').child($uid).child('lastSeen').val() === 'contacts' && (root.child('user_chats').child($uid).child($uid + '_' + auth.uid).exists() || root.child('user_chats').child($uid).child(auth.uid + '_' + $uid).exists())) || !root.child('privacy').child($uid).child('lastSeen').exists())" }
      }
    },

    "contact_info": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "phone": { ".read": "auth != null && (auth.uid === $uid || root.child('privacy').child($uid).child('phone').val() === 'all' || (root.child('privacy').child($uid).child('phone').val() === 'contacts' && (root.child('user_chats').child($uid).child($uid + '_' + auth.uid).exists() || root.child('user_chats').child($uid).child(auth.uid + '_' + $uid).exists())))", ".validate": "newData.isString() && newData.val().length <= 20" }
      }
    },

    "key_backups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['s','i','c','pub']) && newData.child('c').isString() && newData.child('c').val().length <= 400"
      }
    },

    "slow": {
      "$cid": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" } }
    },

    "phones": {
      "$h": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.val() === auth.uid || data.val() === auth.uid)",
        ".validate": "$h.matches(/^[a-f0-9]{32}$/) && newData.isString()"
      }
    },

    "typing": {
      "$cid": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    "reads": {
      "$cid": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    "media": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('from').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['from','mime','data']) && newData.child('data').isString() && newData.child('data').val().length <= 1800000)"
      }
    }
  }
}
