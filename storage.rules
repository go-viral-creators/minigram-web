rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can write only inside their own folder; max 40 MB per object (video limit is 30 MB).
    // Chat media is client-side-encrypted ciphertext (application/octet-stream), so no
    // content-type allow-list here; avatars / channel images are plain images.
    match /media/{uid}/{allPaths=**} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 40 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
