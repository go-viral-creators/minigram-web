
{
  "rewrites": [
    { "source": "/c/:handle", "destination": "/index.html?type=channel&handle=:handle" },
    { "source": "/u/:handle", "destination": "/index.html?type=user&handle=:handle"   }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
